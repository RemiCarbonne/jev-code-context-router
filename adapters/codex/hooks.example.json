{
  "description": "Route coding prompts through jev-context without MCP.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jev-context codex-hook",
            "timeout": 30,
            "statusMessage": "Selecting repository context",
            "additionalContextLimit": 16000
          }
        ]
      }
    ]
  }
}
